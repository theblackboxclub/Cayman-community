"use client";
import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { db, auth } from '../../firebase';
import { onAuthStateChanged } from 'firebase/auth';
import { collection, query, where, onSnapshot, doc, updateDoc } from 'firebase/firestore';

export default function Inbox() {
  const router = useRouter();
  const [notifications, setNotifications] = useState([]);
  const [loading, setLoading] = useState(true);
  const [user, setUser] = useState(null);

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      if (!currentUser) {
        router.push('/signup');
        return;
      }
      setUser(currentUser);

      const q = query(collection(db, "notifications"), where("toUserId", "==", currentUser.uid));
      
      const unsubNotifs = onSnapshot(q, (snapshot) => {
        const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        // Client-side sort
        data.sort((a, b) => (b.createdAt?.seconds || 0) - (a.createdAt?.seconds || 0));
        setNotifications(data);
        setLoading(false);
      });

      return () => unsubNotifs();
    });
    return () => unsubscribe();
  }, [router]);

  const markAsRead = async (notifId, postId) => {
    try {
      await updateDoc(doc(db, "notifications", notifId), { read: true });
    } catch (e) { console.log("Error marking read", e); }
    router.push(`/post/${postId}`);
  };

  const formatTime = (date) => {
    if (!date) return "";
    const now = new Date();
    const jsDate = date.toDate();
    const diff = Math.floor((now - jsDate) / 1000);
    if (diff < 60) return `${diff}s`;
    if (diff < 3600) return `${Math.floor(diff/60)}m`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h`;
    return `${Math.floor(diff/86400)}d`;
  };

  if (loading) return <div className="p-10 text-center text-gray-400">Loading Inbox... 🔔</div>;

  return (
    <div className="min-h-screen bg-white pb-20">
      <div className="bg-white px-4 py-3 flex items-center shadow-sm sticky top-0 z-50">
        <button onClick={() => router.back()} className="mr-4 text-gray-600">⬅</button>
        <span className="font-bold text-lg">Inbox</span>
      </div>

      <div className="max-w-md mx-auto">
        {notifications.length === 0 && (
           <div className="flex flex-col items-center justify-center py-20 text-gray-400">
             <span className="text-4xl mb-2">📭</span>
             <p>No notifications yet.</p>
           </div>
        )}

        {notifications.map((n) => (
          <div 
            key={n.id} 
            onClick={() => markAsRead(n.id, n.postId)}
            className={`p-4 border-b border-gray-100 cursor-pointer hover:bg-gray-50 transition flex gap-3 ${n.read ? 'opacity-60' : 'bg-blue-50'}`}
          >
            {/* User Avatar */}
            <div className="w-10 h-10 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
              {n.fromUsername ? n.fromUsername.charAt(0) : "?"}
            </div>
            
            <div className="flex-1">
              <p className="text-sm text-gray-800">
                {/* DISPLAY THE USERNAME BOLDLY */}
                <span className="font-bold">u/{n.fromUsername || 'Someone'}</span> {n.message}
              </p>
              <span className="text-xs text-gray-400 font-bold mt-1 block">{formatTime(n.createdAt)}</span>
            </div>
            
            {!n.read && <div className="w-2 h-2 bg-blue-500 rounded-full mt-2"></div>}
          </div>
        ))}
      </div>
    </div>
  );
}
